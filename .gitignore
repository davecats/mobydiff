# Validation run artifacts
validation/**/runs/
validation/**/ic/
validation/**/smoke/
validation/interface_decay/decay_*.h5
validation/interface_decay/run.log

# run outputs / scratch
validation/beltrami/suite/
validation/*/runs/
__pycache__/
*.pyc
validation/channel_interface/les/runs/

# Solver output & large binaries (regenerated; keep them out of git so
# `git add -A` never sweeps run outputs into commits). Add a `!path` exception
# below when a binary genuinely belongs in the repo.
*.h5
*.png
*.xmf

# Exceptions: reference data / figures that ARE committed on purpose.
!.mobydiff.png
!tools/mobygeom_tests/**/*.h5
# (tutorials/sailplane/*.h5 was an exception for the legacy coefficient file,
#  retired at numerics-review step 7-4; the case file there is a build product)
!validation/channel_interface/divergence_comparison.png
!validation/channel_interface/les/*.png
!validation/channel_interface/les_ibm/*.png
!validation/channel_interface/les_ibm/*.h5

# Cluster staging trees copied back from HoreKa: a full clone with build
# artifacts (moby-2to1-code) and the run staging dir that setup_and_run.sh
# recreates. The RESULTS are committed separately as results_job<jobid>/.
tutorials/turbulentBoundaryLayer/overheadTest/horeka/moby-2to1-code/
tutorials/turbulentBoundaryLayer/overheadTest/horeka/moby-2to1-run/
tools/h5maxdiff
# passive-scalar bit-exactness suite scratch (validation/scalar/run_bitexact.sh)
.bx_*
# validation/freestream/run_bitexact_outlet.sh and run_restart_outlet.sh:
# per-side inis, logs, forces traces (their snapshots fall under *.h5)
.obx_*
obx_*.forces.txt
.rst_*
# validation/redblack_interface/run_gates.sh: per-leg inis and the rank comparison
validation/redblack_interface/.gate_*
validation/redblack_interface/.cmp_rank.txt
# validation/diffusion_limit/run_gate.sh: per-leg inis and prepare logs
.dl_*
# validation/courant_limit/run_gate.sh: the same
.cl_*

# passive-scalar S3 gate scratch (run_bitexact_s3.sh, run_gates_s3.sh)
.s3x_*
validation/scalar/.*.ini

# passive-scalar gate OUTPUTS: the runtime heat/force traces ([scalar]
# heat_file, the airfoil force files) and the profiles the checkers --dump.
# All regenerated by run_gates_s*.sh; the *.h5 rule above already covers the
# snapshots, and these are the same class. Nothing under validation/scalar is
# a committed .txt/.dat reference (the only tracked one in validation/ is
# sd7003/sd7003.dat, an airfoil coordinate INPUT).
validation/scalar/*.txt
validation/scalar/*.dat

# docs/conjugate: the derivation note is BUILT from the .tex (`make` in that
# directory), so the PDF is a build product, not a source.
docs/conjugate/*.pdf
docs/conjugate/*.aux
docs/conjugate/*.fls
docs/conjugate/*.fdb_latexmk
docs/conjugate/*.log

# conjugate-interface C1 gate scratch (validation/conjugate/run_gates_c1.sh):
# the generated case inis, the slab STLs the gate writes per cut position, and
# the prepare/solve traces. The *.h5 and *.log rules above already cover the
# case files and snapshots; the tracked sources are the two committed .ini
# templates, the checkers and the driver.
validation/conjugate/.*.ini
validation/conjugate/*.stl
# ...and the C2 measurement tables (run_gates_c2.sh): every number they hold
# is recorded in validation/conjugate/README.md, which is the durable record.
validation/conjugate/c2_*.dat

# step-7 prepare/solve gate scratch (validation/prepare/run_gates_step7.sh):
# generated inis and case files in the case directories, and the suite
# snapshots that the les_ibm exception above would otherwise sweep in.
.s7_*
s7_*
validation/channel_interface/les_ibm/bx_*.h5
validation/channel_interface/les_ibm/s3x_*.h5
validation/channel_interface/les_ibm/runs_f7/
